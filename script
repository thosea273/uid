/*grid*/
function renderProductGrid() {
    const grid = document.getElementById("product-grid");
    grid.innerHTML = PRODUCTS.map(p => {

    let imgHtml = "";
    if (p.img) {
    imgHtml = `<img class="product-card__img" src="${p.img}">`;

    } else {
    imgHtml = `
        <div class="product-card__placeholder"
        style="background:${p.color}">
        IMAGE
        </div>
        `;
    }
       
    return `
    <article class="product-card" onclick="openProduct(${p.id})">
      ${imgHtml}
      <div class="product-card__info">
        <p>${p.name}</p>
        <p>$${p.price.toFixed(2)} ${p.currency}</p>
      </div>
    </article>
  `;
}).join("");
}

function openProduct(id) {
    const product= PRODUCTS.find(p => p.id === id);

    if (!product || !product.detail) {
      populateDetail(PRODUCTS[0]);
    } else {
      populateDetail(product);
    }
    goto("detail");
  }




/*product details*/

let selectedSize = "XS";
let selectedSwatch = 0;
let currentProduct = null;

function populateDetail(product) {
  currentProduct = product;
  const d = product.detail || {};


  /* images */
  const imgWrap =
    document.getElementById(
      "detail-images"
    );
    if (
    imgWrap &&
    d.images
    ) {

    let html = "";

    d.images.forEach(
      function (
        src,
        index
      ) {

    html += `
    <div class="detail__img-wrap">

    <img
    src="${src}"
    class="detail__img"
    alt="${product.name}">

    `;

    if (
    index === 1
    ) {

    html += `
    <div class="tryon-label">
        TRY ON
    </div>
     `;
    }

    html += `
    </div>
    `;
    }
    );

    imgWrap.innerHTML =
      html;
  }

  /* title */
  updateText(
    "detail-badge",
    d.badge || "PRE-ORDER"
  );

  updateText(
    "detail-title",
    d.title || product.name
  );

  updateText(
    "detail-price",
    "$" +
    product.price.toFixed(2) +
    " " +
    product.currency
  );

/* description */
